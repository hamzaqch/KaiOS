{
  "$schema": "kaios-hooks-v1",
  "version": 1,
  "generated": "{{now}}",
  "cwd": "{{repo}}",
  "hooks": {
    "{{event}}": [
      {
        "type": "command",
        "bash": "sh {{shell_wrapper}} {{event}}",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File {{wrapper}} {{event}}",
        "timeoutSec": 20,
        "env": {
          "PYTHONPATH": "{{framework}}",
          "KAIOS_HOME": "{{home}}"
        }
      }
    ],
    "{{nested_event}}": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File {{wrapper}} {{nested_event}}",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "x-kaios": {
    "note": "Template. The {{event}} entry is the shape every event shipped under the Copilot CLI engine's camelCase name takes; the {{nested_event}} entry is the shape the two PascalCase-only events take. `kaios setup render` expands both across every registered event and writes absolute wrapper paths."
  }
}
