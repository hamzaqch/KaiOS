{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "sh .github/hooks/kaios.sh sessionStart",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 sessionStart",
        "timeoutSec": 20
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "sh .github/hooks/kaios.sh userPromptSubmitted",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 userPromptSubmitted",
        "timeoutSec": 20
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh .github/hooks/kaios.sh preToolUse",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 preToolUse",
        "timeoutSec": 20
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "sh .github/hooks/kaios.sh postToolUse",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 postToolUse",
        "timeoutSec": 20
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 PreCompact",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 SubagentStart",
            "timeout": 20
          }
        ]
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "sh .github/hooks/kaios.sh subagentStop",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 subagentStop",
        "timeoutSec": 20
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "sh .github/hooks/kaios.sh agentStop",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 agentStop",
        "timeoutSec": 20
      }
    ]
  }
}
