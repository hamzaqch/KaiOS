{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks SessionStart",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 SessionStart",
        "timeout": 20
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks UserPromptSubmit",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 UserPromptSubmit",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks PreToolUse",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 PreToolUse",
        "timeout": 20
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks PostToolUse",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 PostToolUse",
        "timeout": 20
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks PreCompact",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 PreCompact",
        "timeout": 20
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks SubagentStart",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 SubagentStart",
        "timeout": 20
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks SubagentStop",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 SubagentStop",
        "timeout": 20
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -m kaios.hooks Stop",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/kaios.ps1 Stop",
        "timeout": 20
      }
    ]
  }
}
